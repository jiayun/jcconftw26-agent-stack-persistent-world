# 複製成 repo 根目錄的 .env；後端啟動時自動載入，修改後需重啟。
# 使用 KEY=value，不加引號或 export；註解請獨立一行。
# 預設離線，不會呼叫模型。使用真實模型時將 WORLD_MODE 改成 live，
# 並填入 WORLD_MODEL 與 OPENAI_API_KEY。
WORLD_MODE=offline
# 填入服務提供的模型 ID
WORLD_MODEL=
OPENAI_API_KEY=
# API 根網址需包含版本路徑；不要加 /chat/completions。
OPENAI_BASE_URL=https://api.openai.com/v1
# 本機 Ollama 的 OpenAI 相容 API：
# OPENAI_BASE_URL=http://localhost:11434/v1

# 遊戲服務
WORLD_MCP_ENABLED=false
WORLD_DEBUG=false
PORT=8080
WORLD_DATABASE_URL=jdbc:h2:file:./data/spring-festival;DB_CLOSE_ON_EXIT=FALSE
